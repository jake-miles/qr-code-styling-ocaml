(rule
 (targets libqr_code_styling.a dllqr_code_styling.so)
 (deps (glob_files *.rs))
 (action
  (progn
   (run sh -c "cd %{project_root}/../.. && cargo build --release")
   (run sh -c
     "mv %{project_root}/../../target/release/libqr_code_styling.so ./dllqr_code_styling.so 2> /dev/null || \
      mv %{project_root}/../../target/release/libqr_code_styling.d ./dllqr_code_styling.so")
   (run mv %{project_root}/../../target/release/libqr_code_styling.a libqr_code_styling.a))))

(library
 (name qr_code_styling)
 (public_name qr-code-styling)
 (foreign_archives qr_code_styling)
 (c_library_flags
  (-lpthread -lc -lm)))
